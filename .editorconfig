# http://editorconfig.org
root = true

# Spaces, not tabs, so the editor agrees with Prettier. This file said
# indent_style = tab until the repo adopted the shared Prettier config; leaving
# it would have meant the editor re-indenting on save and format:check undoing
# it on the next run.
[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
